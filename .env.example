# Meta publishing credentials. Copy to .env and fill in. Never commit .env.
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_USER_TOKEN=
META_GRAPH_VERSION=v23.0

# Public image host: the GitHub Pages project URL, no trailing slash.
# Example: https://yourname.github.io/Cluefolio
PUBLIC_BASE_URL=https://YOURUSER.github.io/Cluefolio

# Optional
DISCORD_WEBHOOK_URL=
META_FB_ALT_TEXT=true
